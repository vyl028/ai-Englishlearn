# ── 前端 API 地址（通常不需要设置）────────────────────────────
# 不设置时，前端自动用当前页面 hostname 拼接 :4000（电脑/手机均可）
# 仅在生产环境或需要固定地址时才取消注释：
# NEXT_PUBLIC_API_URL=http://your-server-ip:4000

# AI provider selection: gemini | openai
# - If AI_PROVIDER is omitted, the app auto-detects based on which API keys are set.
AI_PROVIDER=gemini

# Gemini (Google)
# Prefer setting GOOGLE_API_KEY. GEMINI_API_KEY is also accepted for compatibility.
GOOGLE_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional: if you use a proxy/mirror for the Gemini endpoint
# GEMINI_BASE_URL=

# OpenAI / OpenAI-compatible (Chat Completions)
OPENAI_API_KEY=
# Base URL should typically include /v1 (default: https://api.openai.com/v1)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# AI request behavior (optional)
# Timeout in milliseconds (default: 60000)
# AI_TIMEOUT_MS=60000
# Max retries for 429/5xx/network errors (default: 2)
# AI_MAX_RETRIES=2
# Enable AI debug logs: 1 | true | on
# AI_DEBUG=1
