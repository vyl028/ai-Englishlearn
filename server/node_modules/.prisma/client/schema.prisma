generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  words         Word[]
  groups        Group[]
  learningStats LearningStats?
  growthGoals   GrowthGoals?

  @@map("users")
}

model Group {
  id        String   @id @default(uuid())
  name      String
  order     Int      @default(0)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  words Word[]

  @@unique([userId, name])
  @@map("groups")
}

model Word {
  id           String  @id @default(uuid())
  word         String
  partOfSpeech String
  definition   String
  enrichment   String? // JSON string

  userId  String
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId String?
  group   Group?  @relation(fields: [groupId], references: [id], onDelete: SetNull)

  capturedAt DateTime @default(now())
  isMastered Boolean  @default(false)
  photoData  String? // base64 图片数据

  masteryStats WordMasteryStats[]

  @@unique([userId, word, partOfSpeech])
  @@map("words")
}

model LearningStats {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  totalXp      Int @default(0)
  currentLevel Int @default(1)

  lastCheckIn   DateTime?
  streakDays    Int       @default(0)
  longestStreak Int       @default(0)

  totalWords    Int @default(0)
  masteredWords Int @default(0)

  unlockedBadges String @default("[]")

  // Extended gamification fields
  lastActiveDate    DateTime?
  practiceCompleted Int       @default(0)
  storiesGenerated  Int       @default(0)
  masteredMarked    Int       @default(0)
  dailyStats        String    @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("learning_stats")
}

model GrowthGoals {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  weeklyXpGoal    Int @default(200)
  weeklyWordsGoal Int @default(20)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("growth_goals")
}

model ReadingQuestionStats {
  id         String @id @default(uuid())
  userId     String
  articleKey String

  attempts Int       @default(0)
  best     Int       @default(0)
  last     Int       @default(0)
  total    Int       @default(0)
  bestAt   DateTime?
  lastAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, articleKey])
  @@map("reading_question_stats")
}

model SpeakingTrainingStats {
  id      String @id @default(uuid())
  userId  String
  dateKey String

  attempts Int       @default(0)
  scoreSum Int       @default(0)
  best     Int       @default(0)
  last     Int       @default(0)
  lastAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, dateKey])
  @@map("speaking_training_stats")
}

model LearningEvent {
  id           String   @id @default(uuid())
  userId       String
  type         String
  count        Int?
  correctCount Int?
  totalCount   Int?
  wordCount    Int?
  termKey      String?
  at           DateTime @default(now())

  createdAt DateTime @default(now())

  @@index([userId, at])
  @@map("learning_events")
}

// ===== Practice Records =====

model PracticeRecord {
  id            String   @id @default(uuid())
  userId        String
  questionsJson String // JSON string of GeneratePracticeOutput
  wordIds       String // JSON array of word IDs used in this practice
  questionCount Int      @default(0)
  correctCount  Int      @default(0)
  totalCount    Int      @default(0)
  isSubmitted   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  answers PracticeAnswer[]

  @@index([userId, createdAt])
  @@map("practice_records")
}

model PracticeAnswer {
  id               String         @id @default(uuid())
  practiceRecordId String
  practiceRecord   PracticeRecord @relation(fields: [practiceRecordId], references: [id], onDelete: Cascade)

  questionIndex Int
  questionType  String
  word          String
  promptEn      String

  userAnswer    String? // JSON string: mcq index, blank text, or reorder array
  correctAnswer String? // JSON string
  isCorrect     Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([practiceRecordId, questionIndex])
  @@map("practice_answers")
}

model AiConfig {
  id          String   @id @default(uuid())
  userId      String   @unique
  provider    String   @default("openai") // openai / gemini / anthropic 等标签
  model       String   @default("") // 主模型名称
  visionModel String   @default("") // 视觉模型名称
  baseUrl     String   @default("") // API 基础地址
  apiKey      String   @default("") // API 密钥（空则回退到环境变量）
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("ai_configs")
}

model LearningPlan {
  id       String @id @default(uuid())
  userId   String
  dateKey  String // YYYY-MM-DD
  planType String // daily / weekly
  status   String @default("pending") // pending / in_progress / completed / skipped

  evaluationSnapshot String // JSON: { overallScore, vocabularyScore, practiceScore, activityScore }

  title String
  tasks String // JSON array of tasks

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, dateKey, planType])
  @@index([userId, createdAt])
  @@map("learning_plans")
}

// ===== Word Mastery Stats =====

model WordMasteryStats {
  id     String @id @default(uuid())
  userId String
  wordId String
  word   Word   @relation(fields: [wordId], references: [id], onDelete: Cascade)

  totalAppeared      Int       @default(0) // 在练习中出现的总次数
  totalCorrect       Int       @default(0) // 答对总次数
  consecutiveCorrect Int       @default(0) // 连续答对次数
  lastAnsweredAt     DateTime?
  masteryScore       Int       @default(0) // 0-100 掌握度分数
  isAutoMastered     Boolean   @default(false) // 是否被自动判定为已掌握

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, wordId])
  @@index([userId, masteryScore])
  @@map("word_mastery_stats")
}
