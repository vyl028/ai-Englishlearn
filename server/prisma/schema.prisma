generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  words         Word[]
  groups        Group[]
  learningStats LearningStats?
  growthGoals   GrowthGoals?

  @@map("users")
}

model Group {
  id        String   @id @default(uuid())
  name      String
  order     Int      @default(0)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  words Word[]

  @@unique([userId, name])
  @@map("groups")
}

model Word {
  id           String   @id @default(uuid())
  word         String
  partOfSpeech String
  definition   String
  enrichment   String?  // JSON string

  userId  String
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId String?
  group   Group?  @relation(fields: [groupId], references: [id], onDelete: SetNull)

  capturedAt DateTime @default(now())
  isMastered Boolean  @default(false)
  photoData  String?  // base64 图片数据

  @@unique([userId, word, partOfSpeech])
  @@map("words")
}

model LearningStats {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  totalXp       Int      @default(0)
  currentLevel  Int      @default(1)

  lastCheckIn   DateTime?
  streakDays    Int      @default(0)
  longestStreak Int      @default(0)

  totalWords    Int      @default(0)
  masteredWords Int      @default(0)

  unlockedBadges String @default("[]")

  // Extended gamification fields
  lastActiveDate   DateTime?
  practiceCompleted Int @default(0)
  storiesGenerated  Int @default(0)
  masteredMarked    Int @default(0)
  dailyStats        String @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("learning_stats")
}

model GrowthGoals {
  id              String @id @default(uuid())
  userId          String @unique
  user            User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  weeklyXpGoal    Int    @default(200)
  weeklyWordsGoal Int    @default(20)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("growth_goals")
}

model ReadingQuestionStats {
  id         String   @id @default(uuid())
  userId     String
  articleKey String

  attempts   Int      @default(0)
  best       Int      @default(0)
  last       Int      @default(0)
  total      Int      @default(0)
  bestAt     DateTime?
  lastAt     DateTime?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, articleKey])
  @@map("reading_question_stats")
}

model SpeakingTrainingStats {
  id        String   @id @default(uuid())
  userId    String
  dateKey   String

  attempts  Int      @default(0)
  scoreSum  Int      @default(0)
  best      Int      @default(0)
  last      Int      @default(0)
  lastAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, dateKey])
  @@map("speaking_training_stats")
}

model LearningEvent {
  id          String   @id @default(uuid())
  userId      String
  type        String
  count       Int?
  correctCount Int?
  totalCount  Int?
  wordCount   Int?
  termKey     String?
  at          DateTime @default(now())

  createdAt   DateTime @default(now())

  @@index([userId, at])
  @@map("learning_events")
}
